# Google Gemini configuration
# All LLM configuration is loaded from environment variables.
# Copy this file to .env and edit locally. Never commit .env.

GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
# Verified responsive Gemini cloud fallbacks (comma-separated, tried in order on 503/504/429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_SINGLE_REQUEST_TOKENS=16000

# Local-only Ollama fallback (auto-skipped cleanly when localhost:11434 is unreachable, e.g. Streamlit Cloud)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Optional alias also supported by the SDK:
# GOOGLE_API_KEY=
